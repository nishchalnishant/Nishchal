---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import projectsData from '../data/projects.json';
import articlesData from '../data/articles.json';

const projects = projectsData;
const articles = articlesData;
---

<Layout title="Nishchal | MLOps Engineer">
  <main class="lg:h-screen w-full flex flex-col lg:flex-row overflow-hidden bg-[var(--bg-color)]">
    <!-- Left Panel: Hero / Profile -->
    <section class="lg:w-[35%] w-full h-auto lg:h-full border-b lg:border-b-0 lg:border-r border-[var(--border-color)] bg-[var(--bg-color)]">
      <Hero />
    </section>

    <!-- Right Panel: Content Grid -->
    <div class="lg:w-[65%] w-full h-full flex flex-col p-6 lg:p-10 overflow-y-auto lg:overflow-hidden gap-8 bg-[var(--bg-color)]">
      
      <!-- Section 1: Technical Writing (Priority) -->
      <section class="flex-1 min-h-0 flex flex-col">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold text-[var(--text-color)] tracking-tight">Technical Writing</h2>
            <div class="h-[1px] flex-grow bg-[var(--border-color)] ml-4 opacity-50"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 h-full overflow-y-auto pr-2 custom-scrollbar pb-2">
          {articles.map((article) => (
            <ArticleCard {...article} />
          ))}
        </div>
      </section>

      <!-- Section 2: Projects -->
      <section class="flex-1 min-h-0 flex flex-col">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold text-[var(--text-color)] tracking-tight">Featured Projects</h2>
            <div class="h-[1px] flex-grow bg-[var(--border-color)] ml-4 opacity-50"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 h-full overflow-y-auto pr-2 custom-scrollbar pb-2">
            {projects.map((project) => (
              <ProjectCard {...project} />
            ))}
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  /* Minimalist Scrollbar */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: var(--border-color);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: var(--muted-color);
  }
</style>
