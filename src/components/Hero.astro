---
---
<div class="h-full flex flex-col justify-center p-8 lg:p-12">
  <div class="mb-4 inline-block px-2.5 py-0.5 rounded text-[var(--accent-color)] text-xs font-mono font-medium border border-[var(--border-color)] w-fit bg-[var(--hover-bg)]">
    MLOps Engineer
  </div>
  
  <h1 class="text-3xl lg:text-4xl font-bold tracking-tight text-[var(--text-color)] mb-3">
    Nishchal
  </h1>
  
  <p class="text-sm lg:text-base text-[var(--muted-color)] mb-8 max-w-sm leading-relaxed font-normal">
    Specializing in scalable AI systems, algorithmic trading bots, and production MLOps pipelines.
  </p>
  
  <div class="flex flex-col gap-2 w-full max-w-xs">
    <a href="/Nishchal/resume.pdf" target="_blank" class="flex items-center justify-center py-2 px-4 bg-[var(--text-color)] text-[var(--bg-color)] text-sm font-medium rounded-md hover:opacity-90 transition-opacity">
       View Resume
    </a>
    <div class="flex gap-2">
        <a href="https://github.com/nishchalnishant" target="_blank" class="flex-1 flex items-center justify-center py-2 px-4 bg-[var(--card-bg)] text-[var(--text-color)] text-sm font-medium rounded-md border border-[var(--border-color)] hover:bg-[var(--hover-bg)] transition-colors">
            GitHub
        </a>
        <a href="mailto:nishchalnishant@gmail.com" class="flex-1 flex items-center justify-center py-2 px-4 bg-[var(--card-bg)] text-[var(--text-color)] text-sm font-medium rounded-md border border-[var(--border-color)] hover:bg-[var(--hover-bg)] transition-colors">
            Email
        </a>
    </div>
  </div>
  
  <div class="mt-12">
    <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--muted-color)] mb-3">Tech Context</h3>
    <div class="flex flex-wrap gap-1.5">
        {['Python', 'Torch', 'K8s', 'Azure', 'Docker'].map((tech) => (
            <span class="text-[10px] text-[var(--secondary)] font-mono">{tech}</span>
        ))}
    </div>
  </div>
</div>
