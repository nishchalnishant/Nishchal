---
interface Props {
  title: string;
  description: string;
  liveUrl: string;
  repoUrl: string;
  tags: string[];
}

const { title, description, liveUrl, repoUrl, tags } = Astro.props;
---

<div class="relative flex flex-col p-4 bg-[var(--card-bg)] border border-[var(--card-border)] rounded-lg hover:bg-[var(--hover-bg)] transition-colors h-full group">
  <!-- Full card click area -->
  <a href={repoUrl} target="_blank" class="absolute inset-0 z-0" aria-label={`View source for ${title}`}></a>

  <div class="relative z-10 flex justify-between items-start mb-2 pointer-events-none">
    <h3 class="text-sm font-semibold text-[var(--text-color)] group-hover:underline decoration-[var(--muted-color)] underline-offset-4">
      {title}
    </h3>
    <div class="flex gap-2 pointer-events-auto">
       {liveUrl !== '#' && (
        <a href={liveUrl} target="_blank" class="text-[var(--muted-color)] hover:text-[var(--text-color)] p-1 hover:bg-[var(--bg-color)] rounded transition-colors" title="Live Demo">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
        </a>
       )}
    </div>
  </div>
  
  <p class="relative z-0 text-xs text-[var(--muted-color)] mb-3 line-clamp-2 flex-grow font-normal leading-relaxed pointer-events-none">
    {description}
  </p>
  
  <div class="relative z-0 flex flex-wrap gap-1.5 mt-auto pointer-events-none">
    {tags.slice(0, 3).map((tag) => (
      <span class="px-1.5 py-0.5 text-[10px] text-[var(--text-color)] bg-[var(--hover-bg)] rounded border border-[var(--border-color)] font-mono">
        {tag}
      </span>
    ))}
  </div>
</div>
