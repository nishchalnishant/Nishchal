---
interface Props {
  title: string;
  description: string;
  url: string;
  tag: string;
}

const { title, description, url, tag } = Astro.props;
---

<a 
  href={url} 
  target="_blank" 
  rel="noopener noreferrer"
  class="group flex flex-col justify-between p-4 bg-gray-900/50 border border-gray-800 rounded-xl hover:bg-gray-800 hover:border-gray-600 transition-all duration-200 h-full"
>
  <div>
    <div class="flex justify-between items-start mb-2">
       <span class="text-xs font-mono text-gray-500 group-hover:text-blue-400 transition-colors uppercase tracking-wider">
        {tag}
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-600 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </div>
    
    <h3 class="text-sm font-semibold text-gray-200 group-hover:text-white mb-1 line-clamp-1">
      {title}
    </h3>
  </div>
  
  <p class="text-xs text-gray-500 line-clamp-2 mt-2 group-hover:text-gray-400">
    {description}
  </p>
</a>
